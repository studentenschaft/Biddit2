# Copy to .env.local to override. Defaults (shown) are the production values.
# These are public client identifiers and hosts, not secrets.

# Microsoft Entra ID application (client) id used by MSAL.
VITE_ENTRA_CLIENT_ID=67a86d1c-e99b-4b9b-968f-5ac10a21bc5e
# Microsoft Entra ID tenant (directory) id; builds the MSAL authority URL.
VITE_ENTRA_TENANT_ID=a7262e59-1b56-4f5a-a412-6f07181f48ee
# Value of the X-ApplicationId header sent to the university API.
VITE_UNISG_APPLICATION_ID=820e077d-4c13-45b8-b092-4599d78d45ec
# Base URL of the university integration API (no trailing slash).
VITE_UNISG_API_BASE=https://integration.unisg.ch
# Base URL of the SHSG API (no trailing slash); also the host the degraded-mode kill switch blocks.
VITE_SHSG_API_BASE=https://api.shsg.ch
